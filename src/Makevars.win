# Suppress [-Wignored-attributes] from Eigen 3.3.x SSE/SIMD headers under GCC 13+ / Rtools45.
# Applied via -include so it covers RcppExports.cpp (auto-generated, cannot be edited directly).
# Remove once RcppEigen ships Eigen >= 3.4 on CRAN.
PKG_CXXFLAGS = -include suppress_eigen_warnings.h
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
